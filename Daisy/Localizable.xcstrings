        }
      }
    },
    "%@: the answer stopped halfway — %@. Try again." : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@: ответ оборвался на середине — %2$@. Попробуй ещё раз."
          }
        }
      }
    },
    "%@ declined to summarize this transcript." : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ отказался делать саммари этого транскрипта."
          }
        }
      }
    },
    "%@ is kept for the layout fixer, which is off. Turn it on in Transcription → Keyboard layout to change or clear that shortcut." : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ закреплено за исправлением раскладки, а оно выключено. Включи его в «Транскрипция → Раскладка клавиатуры», чтобы изменить или убрать это сочетание."
          }
        }
      }
    },
    "%@: the summary didn't fit the answer limit and came back cut off. Try again, or pick a model with more room." : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@: саммари не поместилось в лимит ответа и пришло обрезанным. Попробуй ещё раз или выбери модель с запасом побольше."
          }
        }
      }
    },
