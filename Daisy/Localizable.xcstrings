            "value" : "Daisy не удалось создать закрытую временную папку для саммари."
          }
        }
      }
    },
    "Daisy couldn't play this audio track." : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Daisy не удалось воспроизвести эту аудиодорожку."
          }
