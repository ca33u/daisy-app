      }
    },
    "A folder with this name already exists." : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Папка с таким именем уже существует."
          }
        }
      }
    },
    "A gentle on-device noise gate softens steady room noise before transcription and saving. Off by default; very quiet voices may sound less natural." : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Локальное мягкое шумоподавление ослабляет постоянный шум помещения перед транскрипцией и сохранением. По умолчанию выключено; очень тихий голос может звучать менее естественно."
          }
        }
      }
    },
    "a meeting" : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "встречу"
          }
