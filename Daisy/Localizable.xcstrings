    "Working day" : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Рабочий день"
          }
        }
      }
    },
    "Write follow-ups in my voice" : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Писать фоллоу-апы в моём стиле"
          }
        }
      }
    },
    "Writes the entry into Claude's config. Restart Claude Desktop afterwards to load Daisy's tools." : {
      "extractionState" : "stale",
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Добавляет запись в конфигурацию Claude. После этого перезапусти Claude Desktop, чтобы загрузить инструменты Daisy."
          }
        }
      }
    },
    "Correcting names and terms" : {
      "extractionState" : "manual",
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Исправление имён и терминов"
          }
        }
      }
    },
    "Looking for speaker names" : {
      "extractionState" : "manual",
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Поиск имён говорящих"
          }
        }
      }
    },
    "Your own settings — none of the plans. Picking one replaces them." : {
      "extractionState" : "manual",
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Свои настройки — ни один план не выбран. Выбор плана их заменит."
          }
        }
      }
    },
    "Switch to “%@”?" : {
      "extractionState" : "manual",
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Переключиться на план «%@»?"
          }
        }
      }
    },
    "Screenshots will be turned off." : {
      "extractionState" : "manual",
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Скриншоты выключатся."
          }
        }
      }
    },
    "Meetings will be processed later, on a charger." : {
      "extractionState" : "manual",
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Встречи будут обрабатываться позже, на зарядке."
          }
        }
      }
    },
    "Screenshots: every 2 minutes at most." : {
      "extractionState" : "manual",
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Скриншоты: не чаще раза в 2 минуты."
          }
        }
      }
    },
    "Your own settings are replaced — you can tune them again under Transcription and Summary." : {
      "extractionState" : "manual",
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Свои настройки заменятся — их можно снова настроить во вкладках «Транскрипция» и «Саммари»."
          }
        }
      }
    },
    "How should Daisy process meetings?" : {
      "extractionState" : "manual",
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Как обрабатывать встречи?"
          }
        }
      }
    },
    "A plan decides how much Daisy does while the meeting is on — and how much battery it takes. The final transcript is the same full quality in every plan." : {
      "extractionState" : "manual",
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "План решает, сколько Daisy делает во время встречи и сколько батареи на это уходит. Итоговый транскрипт одинаково полного качества в любом плане."
          }
        }
      }
    },
    "You can change this anytime in Settings → General." : {
      "extractionState" : "manual",
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Это можно поменять в любой момент в Настройках → Основные."
          }
        }
      }
    },
    "One file mixes everyone's voices together. Two tracks keeps yours and the others' in separate files." : {
      "extractionState" : "manual",
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Один файл — все голоса вместе. Две дорожки — твой голос и голоса собеседников в отдельных файлах."
          }
        }
      }
    },
    "One file" : {
      "extractionState" : "manual",
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Один файл"
          }
        }
      }
    },
    "Two tracks" : {
      "extractionState" : "manual",
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Две дорожки"
          }
        }
      }
    },
    "Your voice" : {
      "extractionState" : "manual",
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "я"
          }
        }
      }
    },
    "Others" : {
      "extractionState" : "manual",
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "собеседники"
          }
        }
      }
    },
    "Replace the existing audio files?" : {
      "extractionState" : "manual",
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Заменить существующие аудиофайлы?"
          }
        }
      }
    },
    "Replace" : {
      "extractionState" : "manual",
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Заменить"
          }
        }
      }
    },
    "The transcript appears after the meeting." : {
      "extractionState" : "manual",
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Транскрипт появится после встречи."
          }
        }
      }
    },
    "Daisy closed unexpectedly" : {
      "extractionState" : "manual",
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Daisy неожиданно закрылась"
          }
        }
      }
    },
    "Send a crash report to the developer? It says where in the code Daisy failed, the app and macOS versions and the Mac model — never your meetings, names, files or devices. The whole report is below." : {
      "extractionState" : "manual",
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Отправить разработчику отчёт о сбое? В нём — где в коде произошёл сбой, версии Daisy и macOS и модель Mac. Никогда — твои встречи, имена, файлы и устройства. Весь отчёт — ниже."
          }
        }
      }
    },
    "Send Report" : {
      "extractionState" : "manual",
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Отправить отчёт"
          }
        }
      }
    },
    "Don't Send" : {
      "extractionState" : "manual",
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Не отправлять"
          }
        }
      }
    },
    "Don't ask again" : {
      "extractionState" : "manual",
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Больше не спрашивать"
          }
        }
      }
    },
    "Crash reports" : {
      "extractionState" : "manual",
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Отчёты о сбоях"
          }
        }
      }
    },
    "Ask every time" : {
      "extractionState" : "manual",
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Спрашивать каждый раз"
          }
        }
      }
    },
    "Never send" : {
      "extractionState" : "manual",
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Никогда не отправлять"
          }
        }
      }
    },
    "After a crash, Daisy asks before sending anything and shows the whole report: where in the code it failed, the app and macOS versions and the Mac model. Never your meetings, names, files or devices. “Never send” applies from the next launch." : {
      "extractionState" : "manual",
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "После сбоя Daisy спросит, прежде чем что-то отправить, и покажет весь отчёт: где в коде произошёл сбой, версии Daisy и macOS и модель Mac. Никогда — твои встречи, имена, файлы и устройства. «Никогда не отправлять» действует со следующего запуска."
          }
        }
      }
