    "A card on Home each day: your meetings, open action items from recent sessions, and what to focus on." : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ежедневная карточка на главном экране: твои встречи, открытые задачи из недавних записей и приоритеты."
          }
        }
      }
    },
    "A code for other apps on this Mac." : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Код для других приложений на этом Mac."
          }
        }
      }
    },
    "A custom per-notification mix from an earlier version. Picking a preset replaces it." : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Индивидуальные настройки уведомлений из предыдущей версии. Выбор пресета заменит их."
          }
        }
      }
    },
    "A few quick questions and permissions, then you're set." : {
      "extractionState" : "stale",
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Несколько коротких вопросов и разрешений — и всё готово."
