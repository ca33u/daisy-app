    "Recommended. A light live transcript, the other side’s speakers told apart." : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Рекомендуем. Лёгкий живой транскрипт, собеседники различаются."
          }
        }
      }
    },
