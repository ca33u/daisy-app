        }
      }
    },
    "Daisy couldn’t save that to disk — check there’s free space and try again." : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Daisy не смогла сохранить это на диск — проверь, есть ли свободное место, и попробуй снова."
          }
        }
      }
    },
    "Daisy couldn't start the Codex App Server." : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Daisy не удалось запустить Codex App Server."
          }
