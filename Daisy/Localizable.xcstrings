    },
    "Daisy couldn't remember the new recordings folder." : {
      "extractionState" : "manual",
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Daisy не удалось сохранить доступ к новой папке с записями."
