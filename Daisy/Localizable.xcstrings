      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Уточняем транскрипт — %lld%%. Ниже черновик со встречи."
          }
        }
      }
    },
    "Refining the transcript… Below is the draft from the meeting." : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Уточняем транскрипт… Ниже черновик со встречи."
