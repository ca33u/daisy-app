      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Мало места на диске (свободно %.1f ГБ) — в этой записи записывается только транскрипт, без аудио. Освободи место, чтобы снова записывать аудио."
