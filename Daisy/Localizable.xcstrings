          }
        }
      }
    },
    "%@ / %@" : {
      "comment" : "A label displaying the current playback time and total duration of the audio. The first argument is the string “%1$d:%2$02d:%3$02d” or the string “%1$d:%2$02d”. The second argument is the string “%1$d:%2$02d:%3$02d” or the string “%1$d:%2$02d”.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ / %2$@"
          }
        }
      }
    },
    "%@ already fixes layouts, so Daisy won’t — two of them would garble the same word. Quit it and Daisy takes over." : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ уже исправляет раскладку, поэтому Daisy не будет — вдвоём они исковеркают одно и то же слово. Закройте её, и Daisy возьмётся сама."
          }
        }
      }
    },
    "%@ copied" : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ скопировано"
          }
        }
      }
    },
    "%@ couldn't be read back. This transcript is roughly %lld tokens — if that's more than the model's context length, %@ cut the top of the prompt and the summary instructions went with it. Raise the context length, or pick a cloud provider for meetings this long." : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Не удалось прочитать ответ %1$@. В транскрипте примерно %2$lld токенов — если это больше контекста модели, %3$@ обрезал начало запроса вместе с инструкциями для саммари. Увеличьте контекст или выберите облачного провайдера для встреч такой длины."
          }
        }
      }
    },
    "%@ cut this transcript down to %lld tokens out of roughly %lld — the summary instructions were in the part it dropped. Raise the model's context length in %@, or pick a cloud provider for meetings this long." : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ обрезал транскрипт до %2$lld токенов из примерно %3$lld — инструкции для саммари остались в отброшенной части. Увеличьте контекст модели в %4$@ или выберите облачного провайдера для встреч такой длины."
          }
        }
      }
    },
    "%@ is already assigned to “%@”. Free it up there first." : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ уже назначено на «%2$@». Сначала освободите его там."
          }
        }
      }
    },
    "%@ is already assigned to %@." : {
      "extractionState" : "stale",
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ уже назначено для «%2$@»."
          }
        }
      }
    },
    "%@ is already detected — no need to add it." : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ и так определяется — добавлять не нужно."
          }
        }
      }
    },
    "%@ is ready for summaries." : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ готов делать саммари."
          }
        }
      }
    },
    "%@ launched — start a meeting?" : {
      "extractionState" : "stale",
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Запущен «%@» — записать встречу?"
          }
        }
      }
    },
    "%@ launched while Daisy is already recording — stop the current session first if you want a fresh one." : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«%@» запущен, пока Daisy уже ведёт запись — сначала остановите текущую запись, если хотите начать новую."
          }
        }
      }
    },
    "%@ limit" : {
      "localizations" : {
