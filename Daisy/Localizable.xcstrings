        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Без звука"
          }
        }
      }
    },
    "Without the microphone Daisy can't record anything — the rest can wait." : {
      "extractionState" : "stale",
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
