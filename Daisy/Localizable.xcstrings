    "Expand" : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Развернуть"
          }
        }
      }
    },
    "Experimental. Transcripts are sent to Cursor through its Agent CLI and count against your Cursor plan's limits; Daisy doesn't estimate a per-request cost. Every run uses an empty temporary folder, never passes `--force`, and installs project-level deny rules for shell, file reads/writes, and MCP. Cursor does not expose a documented switch that removes every tool, so treat this account route as experimental." : {
      "extractionState" : "stale",
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Экспериментально. Транскрипты отправляются в Cursor через Agent CLI и расходуют лимиты вашего плана Cursor; Daisy не оценивает стоимость отдельного запроса. Каждый запуск идёт в пустой временной папке, без `--force`, с запретом команд оболочки, чтения и записи файлов и MCP на уровне проекта. Cursor не предоставляет документированный способ отключить все инструменты, поэтому этот способ подключения считается экспериментальным."
          }
        }
      }
    },
